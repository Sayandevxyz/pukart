# =======================================================
# PUKart - Pondicherry University Campus Marketplace
# Production & Local Environment Configuration
# =======================================================

# Neon PostgreSQL Database Connection
# Required: Connection string to Neon PostgreSQL database
DATABASE_URL=postgresql://user:password@ep-sample-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# Better Auth Secret (generate a random 32+ character key: e.g. `openssl rand -base64 32`)
BETTER_AUTH_SECRET=pukart_secure_campus_marketplace_secret_2026_pondicherry_university

# Better Auth Base Canonical URL
# Local: http://localhost:3000
# Production: https://terminus-ruddy.vercel.app
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth 2.0 Credentials (Mandatory for @pondiuni.ac.in Sign-In)
# Obtain from Google Cloud Console -> APIs & Services -> Credentials
# Authorized Redirect URI:
# http://localhost:3000/api/auth/callback/google
# https://terminus-ruddy.vercel.app/api/auth/callback/google
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-google-client-secret

# Admin Configuration
# Comma-separated list of official admin university emails
ADMIN_EMAILS=admin@pondiuni.ac.in,sayandev@pondiuni.ac.in

# Optional AI Gateway / LLM API Key (For AI Description, Price Recommendation & Natural Search)
AI_GATEWAY_API_KEY=

# Optional Vercel Blob Storage Token (For cloud image uploads; falls back to local /public/uploads/ if omitted)
BLOB_READ_WRITE_TOKEN=

# Optional Vercel Web Analytics
NEXT_PUBLIC_VERCEL_ANALYTICS_ID=
